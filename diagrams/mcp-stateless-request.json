  "cards": [
    {
      "dot": "cyan",
      "title": "Stateless by design",
      "items": [
        "No initialize and no Mcp-Session-Id in the 2026-07-28 core",
        "Request _meta carries protocolVersion, clientCapabilities, clientInfo; the Bearer token is not in _meta, it travels in the Authorization header",
        "Result _meta: io.modelcontextprotocol/serverInfo. Auth only for protected tools; no model in MCP"
      ]
    },
    {
      "dot": "amber",
      "title": "Auth failure (not drawn: success path only)",
      "items": [
        "401 unauthenticated / 403 insufficient scope: no tool execution"
      ]
    }
  ]
